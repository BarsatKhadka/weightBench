{"nodes": [{"id": "alphalore_paper", "label": "AlphaLoRA: Rank Allocation via HT-SR", "file_type": "paper", "source_file": "finding_literature/alphalore_htsr_rank_allocation.pdf", "source_location": "Full paper", "source_url": "https://arxiv.org/abs/2410.10054", "captured_at": "2026-05-07", "author": "Qing, Gao, Zhou, Diao, Yang, Vosoughi", "contributor": "claude-sonnet-4-6"}, {"id": "alphalore_pl_alpha_hill", "label": "PL_Alpha_Hill Metric", "file_type": "paper", "source_file": "finding_literature/alphalore_htsr_rank_allocation.pdf", "source_location": "Section 3: Method, Equation 2", "source_url": "https://arxiv.org/abs/2410.10054", "captured_at": "2026-05-07", "author": "Qing, Gao, Zhou, Diao, Yang, Vosoughi", "contributor": "claude-sonnet-4-6", "rationale": "PL_Alpha_Hill = 1 + k / (sum_{i=1}^k ln(lambda_{n-i+1}/lambda_{n-k})). Hill estimator for power-law exponent alpha of ESD tail. Measures training quality of each layer. Lower alpha = heavier tail = better trained."}, {"id": "alphalore_allocation_formula", "label": "AlphaLoRA Rank Allocation Formula", "file_type": "paper", "source_file": "finding_literature/alphalore_htsr_rank_allocation.pdf", "source_location": "Section 3: Method, Equation 4", "source_url": "https://arxiv.org/abs/2410.10054", "captured_at": "2026-05-07", "author": "Qing, Gao, Zhou, Diao, Yang, Vosoughi", "contributor": "claude-sonnet-4-6", "rationale": "s_i = floor((v_i^beta / sum(v_j^beta)) * T). Allocates total rank budget T across layers proportional to normalized alpha values raised to power beta. Outperforms MoLA baseline with 50% fewer parameters."}, {"id": "alphalore_stable_rank", "label": "Stable Rank Metric", "file_type": "paper", "source_file": "finding_literature/alphalore_htsr_rank_allocation.pdf", "source_location": "Section 2: Background, Definition 2", "source_url": "https://arxiv.org/abs/2410.10054", "captured_at": "2026-05-07", "author": "Qing, Gao, Zhou, Diao, Yang, Vosoughi", "contributor": "claude-sonnet-4-6", "rationale": "Stable_Rank = ||W||_F^2 / ||W||_2^2. Ratio of Frobenius norm squared to spectral norm squared. Soft rank measure robust to small singular values. Used as alternative to integer rank in HT-SR analysis."}, {"id": "alphalore_alpha_hat", "label": "Alpha_Hat Metric", "file_type": "paper", "source_file": "finding_literature/alphalore_htsr_rank_allocation.pdf", "source_location": "Section 2: Background, Definition 3", "source_url": "https://arxiv.org/abs/2410.10054", "captured_at": "2026-05-07", "author": "Qing, Gao, Zhou, Diao, Yang, Vosoughi", "contributor": "claude-sonnet-4-6", "rationale": "Alpha_Hat = alpha * log(lambda_max). Combines power-law exponent with scale of largest eigenvalue. Used as alternative to PL_Alpha_Hill; includes absolute scale information."}, {"id": "alphalore_esd", "label": "Empirical Spectral Density (ESD)", "file_type": "paper", "source_file": "finding_literature/alphalore_htsr_rank_allocation.pdf", "source_location": "Section 2: Background, Definition 1", "source_url": "https://arxiv.org/abs/2410.10054", "captured_at": "2026-05-07", "author": "Qing, Gao, Zhou, Diao, Yang, Vosoughi", "contributor": "claude-sonnet-4-6", "rationale": "ESD = distribution of eigenvalues of A = W^T W. Foundation for HT-SR analysis. Well-trained layers exhibit heavy-tailed ESD; poorly trained layers show bulk (Marchenko-Pastur) ESD."}, {"id": "alphalore_htsr_theory", "label": "Heavy-Tailed Self-Regularization (HT-SR) Theory", "file_type": "paper", "source_file": "finding_literature/alphalore_htsr_rank_allocation.pdf", "source_location": "Section 2: Background", "source_url": "https://arxiv.org/abs/2410.10054", "captured_at": "2026-05-07", "author": "Martin and Mahoney 2019-2021", "contributor": "claude-sonnet-4-6", "rationale": "Well-trained deep network layers exhibit heavy-tailed ESD. Power-law exponent alpha measures implicit regularization quality. HT-SR metrics (PL_Alpha_Hill, Alpha_Hat, Stable_Rank) predict generalization without test data."}, {"id": "alphalore_lora_moe", "label": "LoRA-MoE Architecture", "file_type": "paper", "source_file": "finding_literature/alphalore_htsr_rank_allocation.pdf", "source_location": "Section 4: Experiments", "source_url": "https://arxiv.org/abs/2410.10054", "captured_at": "2026-05-07", "author": "Qing, Gao, Zhou, Diao, Yang, Vosoughi", "contributor": "claude-sonnet-4-6", "rationale": "Multiple LoRA experts per layer with Mixture-of-Experts routing. AlphaLoRA allocates experts (ranks) by HT-SR metrics. Outperforms MoLA with fewer total parameters."}, {"id": "alphalore_experiments", "label": "AlphaLoRA Experiments", "file_type": "paper", "source_file": "finding_literature/alphalore_htsr_rank_allocation.pdf", "source_location": "Section 4: Experiments", "source_url": "https://arxiv.org/abs/2410.10054", "captured_at": "2026-05-07", "author": "Qing, Gao, Zhou, Diao, Yang, Vosoughi", "contributor": "claude-sonnet-4-6", "rationale": "Models: LLaMA-7B, LLaMA-2-7B, Mistral-7B. Tasks: MRPC, CoLA, RTE, ScienceQA, CommonsenseQA, OpenBookQA, GSM8K, SVAMP, AddSub, MultiArith. AlphaLoRA consistently outperforms uniform rank allocation and MoLA baseline."}], "edges": [{"source": "BIG_IDEAS_marchenko_pastur", "target": "alphalore_esd", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "finding_literature/alphalore_htsr_rank_allocation.pdf", "source_location": "Section 2: Background", "weight": 0.9}, {"source": "alphalore_paper", "target": "alphalore_pl_alpha_hill", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "finding_literature/alphalore_htsr_rank_allocation.pdf", "source_location": "Section 3: Method", "weight": 1.0}, {"source": "alphalore_paper", "target": "alphalore_allocation_formula", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "finding_literature/alphalore_htsr_rank_allocation.pdf", "source_location": "Section 3: Method", "weight": 1.0}, {"sourc