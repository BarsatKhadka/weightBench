{"nodes": [{"id": "weight2weight_paper", "label": "Weights2Weights: Interpreting the Weight Space of Customized Diffusion Models", "file_type": "paper", "source_file": "relevant_literature_but_not_limited_to/weight2weight.pdf", "source_location": null, "source_url": "https://arxiv.org/abs/2406.09413", "captured_at": null, "author": "Amil Dravid, Yossi Gandelsman, Kuan-Chieh Wang, Alexei A. Efros, Rameen Abdal, Gordon Wetzstein, Kfir Aberman", "contributor": null}, {"id": "weight2weight_w2w_space", "label": "weights2weights (w2w) Space", "file_type": "rationale", "source_file": "relevant_literature_but_not_limited_to/weight2weight.pdf", "source_location": "Abstract, Section 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A PCA-derived subspace over 60k+ LoRA fine-tuned diffusion model weights, one model per identity, functions as a meta-latent space. Sampling from it yields new identity-encoding models; linear directions correspond to semantic edits. LoRA is used to reduce dimensionality before PCA, making the manifold tractable."}, {"id": "weight2weight_meta_latent_space", "label": "Meta-Latent Space over Model Weights", "file_type": "rationale", "source_file": "relevant_literature_but_not_limited_to/weight2weight.pdf", "source_location": "Section 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unlike GAN latent spaces that control individual images, the w2w meta-latent space controls the model itself, enabling consistent multi-image generation for a subject. This motivates treating model weights as data points in a learnable generative space."}], "edges": [{"source": "weight2weight_paper", "target": "weight2weight_w2w_space", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "relevant_literature_but_not_limited_to/weight2weight.pdf", "source_location": "Abstract", "weight": 1.0}, {"source": "weight2weight_paper", "target": "weig