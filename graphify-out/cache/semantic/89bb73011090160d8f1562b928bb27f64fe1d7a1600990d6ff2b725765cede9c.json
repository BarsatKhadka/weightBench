{"nodes": [{"id": "SYNTHESIS_lol_paradigm", "label": "LoL Paradigm (Learning on LoRAs)", "file_type": "document", "source_file": "finding_literature/SYNTHESIS.md", "source_location": "Section: LoL Discovery", "source_url": "https://arxiv.org/abs/2410.04207", "captured_at": "2026-05-07", "author": "barsatKhadka", "contributor": "claude-sonnet-4-6", "rationale": "Meta-network trained on LoRA weights to predict task properties (e.g., task identity, performance). GL_r symmetry handled via canonicalization equivalent to QR+SVD decomposition. Enables learning directly on LoRA weight space."}, {"id": "SYNTHESIS_canonical_trs_qr_svd", "label": "Canonical TRS via QR+SVD", "file_type": "document", "source_file": "finding_literature/SYNTHESIS.md", "source_location": "Section: Spectrum Discovery", "source_url": null, "captured_at": "2026-05-07", "author": "barsatKhadka", "contributor": "claude-sonnet-4-6", "rationale": "Resolves LoRA factorization ambiguity: QR decompose B, then SVD of R, then TRS = log(sigma_i / lambda_MP_edge). Produces unique canonical representation invariant to GL_r transformations."}, {"id": "SYNTHESIS_task_arithmetic_kernel", "label": "Task Arithmetic Kernel", "file_type": "rationale", "source_file": "finding_literature/SYNTHESIS.md", "source_location": "Section: Second Deep Idea", "source_url": null, "captured_at": "2026-05-07", "author": "barsatKhadka", "contributor": "claude-sonnet-4-6", "rationale": "Kernel function on task pairs defined via TRS inner product. Enables geometric task arithmetic: task addition, subtraction, interpolation in TRS space. Connects to kernel methods for structured prediction."}, {"id": "SYNTHESIS_rank_normalized_embedding", "label": "Rank-Normalized Spectral Embedding", "file_type": "rationale", "source_file": "finding_literature/SYNTHESIS.md", "source_location": "Section: Second Deep Idea", "source_url": null, "captured_at": "2026-05-07", "author": "barsatKhadka", "contributor": "claude-sonnet-4-6", "rationale": "Embedding