{"nodes": [{"id": "paper:lora_parameter_redundancy", "label": "LoRA Parameter Redundancy and Spectral Encoding (SeLoRA)", "file_type": "pdf", "source_file": "finding_literature/lora_parameter_redundancy_spectral_encoding.pdf", "description": "Analyzes rank and density redundancy in LoRA; proposes SeLoRA reparameterization via sparse inverse spectral transforms (DFT/wavelet)", "properties": {"arxiv_id": "2506.16787v1", "authors": ["Cheng", "Chen", "Chen", "Gao", "Li", "Li", "Tsung"], "institution": "HKUST/HKUST-GZ"}}, {"id": "concept:parameter_redundancy", "label": "Parameter Redundancy in LoRA", "file_type": "concept", "source_file": "finding_literature/lora_parameter_redundancy_spectral_encoding.pdf", "description": "Two types of redundancy in LoRA: (1) rank redundancy - some ranks can be reduced without performance loss; (2) density redundancy - optimizing only sparse subset of parameters preserves expressive power.", "properties": {"types": ["rank redundancy", "density redundancy"], "sparsity_property": "sparse subset of LoRA parameters preserves comparable expressive power"}}, {"id": "concept:selora_method", "label": "SeLoRA: Spectral-encoding Low-Rank Adaptation", "file_type": "concept", "source_file": "finding_literature/lora_parameter_redundancy_spectral_encoding.pdf", "description": "Reparameterizes LoRA adaptation matrices as spatial recovery of sparse spectral components via inverse spectral transforms. W' = W_0 + T(F_B)*T(F_A) with sparse spectral matrices F_A, F_B.", "properties": {"formula": "W' = W_0 + T(F_B)*T(F_A)", "variants": ["SeLoRA_F (DFT)", "SeLoRA_W (wavelet)"], "sparse_ratio": "eta in (0,1); eta=0.4 for commonsense, eta=0.6 for code generation"}}, {"id": "concept:fourier_encoding_selora", "label": "Fourier Encoding in SeLoRA (SeLoRA_F)", "file_type": "concept", "source_file": "finding_literature/lora_parameter_redundancy_spectral_encoding.pdf", "description": "Uses 2D inverse DFT to map sparse spectral matrix F_A to spatial adaptation matrix A_tilde. A_tilde(j,k) = Re[F^{-1}(F_A)] = Re[sum_{u,v} F_A(u,v)*e^{i2pi(uj/r + vk/d)}].", "properties": {"transform": "2D inverse DFT", "formula": "A_tilde(j,k) = Re[sum_{u,v} F_A(u,v)*e^{i2pi(uj/r + vk/d)}]"}}, {"id": "concept:wavelet_encoding_selora", "label": "Wavelet Encoding in SeLoRA (SeLoRA_W)", "file_type": "concept", "source_file": "finding_literature/lora_parameter_redundancy_spectral_encoding.pdf", "description": "Uses 2D inverse wavelet transform for more stable, localized spectral representation. Default uses 2D inverse Haar wavelet; alternatives: Daubechies-4, Biorthogonal, Coiflets.", "properties": {"transform": "2D inverse wavelet", "default": "Haar wavelet", "alternatives": ["Daubechies-4", "Biorthogonal", "Coiflets"]}}, {"id": "concept:spectral_encoding", "label": "Spectral Encoding", "file_type": "concept", "source_file": "finding_literature/lora_parameter_redundancy_spectral_encoding.pdf", "description": "General approach of learning in frequency/spectral domain rather than spatial domain. Sparse spectral matrix F_A with only floor((1-eta)*r*d) learnable entries implicitly encodes a dense spatial adaptation matrix.", "properties": {"sparse_entries": "|Omega| = floor((1-eta)*r*d)", "implicit_density": "dense spatial matrix from sparse spectral matrix"}}, {"id": "concept:amplification_factor", "label": "Amplification Factor (AF) / Reverse AF", "file_type": "concept", "source_file": "finding_literature/lora_parameter_redundancy_spectral_encoding.pdf", "description": "AF = ||DeltaW||_F / ||U_r^T*W*V_r||_F measures amplification of top-r W features. RAF = ||DeltaW||_F / ||U_{d-r}^T*W*V_{d-r}||_F measures amplification of bottom features. SeLoRA reduces RAF (0.04 vs 0.17 for LoRA).", "properties": {"AF_formula": "AF = ||DeltaW||_F / ||U_r^T*W*V_r||_F", "RAF_formula": "RAF = ||DeltaW||_F / ||U_{d-r}^T*W*V_{d-r}||_F", "selora_raf": 0.04, "lora_raf": 0.17}}, {"id": "arch:llama_models", "label": "LLaMA Models (2-7B, 3-8B)", "file_type": "architecture", "so