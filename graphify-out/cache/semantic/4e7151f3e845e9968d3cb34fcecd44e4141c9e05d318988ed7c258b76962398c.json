{"nodes": [{"id": "BIG_IDEAS_task_residual_spectrum", "label": "Task Residual Spectrum (TRS)", "file_type": "document", "source_file": "finding_literature/BIG_IDEAS.md", "source_location": "Section: The Newton Insight", "source_url": null, "captured_at": "2026-05-07", "author": "barsatKhadka", "contributor": "claude-sonnet-4-6", "rationale": "TRS = departure of LoRA B-matrix singular values from the Marchenko-Pastur null distribution. Architecture-agnostic (GL_r-invariant), task-specific, sqrt(N)-bounded by NTK theory. Proposed as universal task fingerprint. Canonical form via QR+SVD resolves factorization ambiguity."}, {"id": "BIG_IDEAS_marchenko_pastur", "label": "Marchenko-Pastur Distribution", "file_type": "document", "source_file": "finding_literature/BIG_IDEAS.md", "source_location": "Section: Theoretical Foundations", "source_url": null, "captured_at": "2026-05-07", "author": "barsatKhadka", "contributor": "claude-sonnet-4-6", "rationale": "RMT null distribution for random matrices, depends only on aspect ratio d_out/r. Singular values conforming to MP = noise; departing = learned task signal. Used as baseline for TRS computation."}, {"id": "BIG_IDEAS_gl_r_invariance", "label": "GL_r Invariance of LoRA B-matrix", "file_type": "document", "source_file": "finding_literature/BIG_IDEAS.md", "source_location": "Section: Manifold Convergence Discovery", "source_url": null, "captured_at": "2026-05-07", "author": "barsatKhadka", "contributor": "claude-sonnet-4-6", "rationale": "Singular values of B matrix invariant under GL_r group action (B -> BM for invertible M). Three independent proofs: algebraic (SymmetriesInWSL), Riemannian geometry (Frechet arXiv:2604.27155), ML (LoL arXiv:2410.04207). Mathematically necessary for principled LoRA comparison."}, {"id": "BIG_IDEAS_intruder_dimensions", "label": "Intruder Dimensions", "file_type": "document", "source_file": "finding_literature/BIG_IDEAS.md", "source_location": "Section: God Nodes Analysis", "source_url": null, "captured_at": "2026-05-07", "author": "barsatKhadka", "contributor": "claude-sonnet-4-6", "rationale": "LoRA B-matrix singular directions that are novel relative to the base model pretrained weight directions. God node with degree 13 in the existing knowledge graph. High TRS = high intruder dimension content."}, {"id": "BIG_IDEAS_fisher_subspace", "label": "Fisher Subspace", "file_type": "document", "source_file": "finding_literature/BIG_IDEAS.md", "source_location": "Section: Novel Idea 7 - Fisher-TRS Alignment", "source_url": null, "captured_at": "2026-05-07", "author": "barsatKhadka", "contributor": "claude-sonnet-4-6", "rationale": "Fisher information matrices guide LoRA initialization into high-curvature subspaces. Approximately shared across architectures under Platonic hypothesis. Fisher-initialized LoRAs predicted to have more similar TRS across models."}, {"id": "BIG_IDEAS_spectral_over_accumulation", "label": "Spectral Over-Accumulation (SVC)", "file_type": "document", "source_file": "finding_literature/BIG_IDEAS.md", "source_location": "Section: Over-Accumulation Discovery", "source_url": null, "captured_at": "2026-05-07", "author": "barsatKhadka", "contributor": "claude-sonnet-4-6", "rationale": "During LoRA merging, task identity resides in distinct singular directions. Shared singular directions over-accumulate, causing interference. SVC = singular value calibration using empirical shared distribution as null."}, {"id": "BIG_IDEAS_2d_layer_selection", "label": "2D Layer Selection Map (alpha x TRS)", "file_type": "document", "source_file": "finding_literature/BIG_IDEAS.md", "source_location": "Section: Novel Idea 2 - 2D Map", "source_url": null, "captured_at": "2026-05-07", "author": "barsatKhadka", "contributor": "claude-sonnet-4-6", "rationale": "Novel layer selection criterion combining AlphaLoRA's PL_Alpha_Hill (alpha) with TRS. Four quadrants: gold (high alpha + high TRS), dormant (high alpha + low TRS), rescued (low alpha + high TRS), noise (low alpha + low TRS)."}, {"id": "BIG_IDEAS_bayesian_spectral_calibration", "label": "Bayesian Spectral Calibration", "file_type": "rationale", "source_file": "finding_literature/BIG_IDEAS.md", "source_location": "Section: Novel Idea 9 - Unified Framework", "source_url": null, "captured_at": "2026-05-07", "author": "barsatKhadka", "contributor": "claude-sonnet-4-6", "rationale": "Unified Bayesian framework where TRS (MP null) and SVC (empirical shared distribution) are special cases of a prior over singular value distributions. Spiked RMT establishes TRS as optimal Bayes estimator of task signal via Gauss-Markov theorem."}, {"id": "BIG_IDEAS_spiked_rmt", "label": "Spiked Random Matrix Theory", "file_type": "rationale", "source_file": "finding_literature/BIG_IDEAS.md", "source_location": "Section: Novel Idea 9", "source_url": null, "captured_at": "2026-05-07", "author": "barsatKhadka", "contributor": "claude-sonnet-4-6", "rationale": "Spiked RMT model: signal matrix plus noise matrix. Establishes theoretical optimality of TRS as Bayes estimator of task signal. BBP transition identifies rank of true signal."}, {"id": "BIG_IDEAS_ntk_rank_bound", "label": "NTK Optimal Rank Bound sqrt(N)", "file_type": "document", "source_file": "finding_literature/BIG_IDEAS.md", "source_location": "Section: Theoretical Foundations", "source_url": null, "captured_at": "2026-05-07", "author": "barsatKhadka", "contributor": "claude-sonnet-4-6", "rationale": "NTK theory implies optimal LoRA rank = sqrt(N) where N is dataset size. Architecture-independent, dataset-dependent bound. Provides upper bound on number of meaningful TRS dimensions."}, {"id": "BIG_IDEAS_grokking_phase_transition", "label": "Grokking as Spectral Phase Transition", "file_type": "rationale", "source_file": "finding_literature/BIG_IDEAS.md", "source_location": "Section: Novel Idea 14 - Grokking", "source_url": null, "captured_at": "2026-05-07", "author": "barsatKhadka", "contributor": "claude-sonnet-4-6", "rationale": "Grokking (delayed generalization) corresponds to a phase transition where effective rank of LoRA B matrix drops. Post-grokking B matrix encodes task's intrinsic geometry in its surviving singular directions."}, {"id": "BIG_IDEAS_universal_weight_subspace", "label": "Universal Weight Subspace Hypothesis", "file_type": "document", "source_file": "finding_literature/BIG_IDEAS.md", "source_location": "Section: Manifold Convergence Discovery", "source_url": null, "captured_at": "2026-05-07", "author": "barsatKhadka", "contributor": "claude-sonnet-4-6", "rationale": "1100+ models converge to shared spectral subspaces within architectures. Open question: do cross-architecture universal subspaces align? Connects to Platonic Representation Hypothesis."}, {"id": "BIG_IDEAS_subspace_geometry_forgetting", "label": "Subspace Geometry and Catastrophic Forgetting", "file_type": "rationale", "source_file": "finding_literature/BIG_IDEAS.md", "source_location": "Section: Novel Idea 11", "source_url": null, "captured_at": "2026-05-07", "author": "barsatKhadka", "contributor": "claude-sonnet-4-6", "rationale": "Minimum principal angle between task gradient subspaces governs catastrophic forgetting during sequential fine-tuning. TRS distance approximates this principal angle without explicit gradient computation."}], "edges": [{"source": "BIG_IDEAS_task_residual_spectrum", "target": "BIG_IDEAS_marchenko_pastur", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "finding_literature/BIG_IDEAS.md", "source_location": "Section: The Newton Insight", "weight": 1.0}, {"source": "BIG_IDEAS_task_residual_spectrum", "target": "BIG_IDEAS_gl_r_invariance", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "finding_literature/BIG_IDEAS.md", "source_location": "Section: The Newton Insight", "weight": 1.0}, {"source": "BIG_IDEAS_task_residual_spectrum", "target": "BIG_IDEAS_intruder_dimensions", "relation": "conceptually_re