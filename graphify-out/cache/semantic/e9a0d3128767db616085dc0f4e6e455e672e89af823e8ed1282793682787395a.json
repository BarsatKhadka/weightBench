{"nodes": [{"id": "loraoriginal_paper", "label": "LoRA: Low-Rank Adaptation of Large Language Models", "file_type": "paper", "source_file": "relevant_literature_but_not_limited_to/LoRa-OriginalPaper.pdf", "source_location": null, "source_url": "https://arxiv.org/abs/2106.09685", "captured_at": null, "author": "Edward Hu, Yelong Shen, Phillip Wallis, Zeyuan Allen-Zhu, Yuanzhi Li, Shean Wang, Lu Wang, Weizhu Chen", "contributor": null}, {"id": "loraoriginal_low_rank_adaptation", "label": "Low-Rank Adaptation (LoRA)", "file_type": "rationale", "source_file": "relevant_literature_but_not_limited_to/LoRa-OriginalPaper.pdf", "source_location": "Section 1-2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Freezes pre-trained weights and injects trainable rank-decomposition matrices (\u0394W=BA) into Transformer layers. Motivated by the low intrinsic dimension of fine-tuning (Aghajanyan et al., 2020; Li et al., 2018). Reduces trainable parameters by ~10,000x vs GPT-3 full fine-tuning with no inference latency since \u0394W can be merged at deploy time."}, {"id": "loraoriginal_rank_deficiency", "label": "Rank Deficiency in Weight Updates", "file_type": "rationale", "source_file": "relevant_literature_but_not_limited_to/LoRa-OriginalPaper.pdf", "source_location": "Section 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The hypothesis that weight changes during adaptation have low intrinsic rank justifies LoRA. Even rank r=1 or r=2 suffices for GPT-3 adaptation (d=12288), confirming the low-rank structure of adaptation deltas."}], "edges": [{"source": "intrinsicdimensionality_intrinsic_dimension", "target": "loraoriginal_low_rank_adaptation", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "relevant_literature_but_not_limited_to/LoRa-OriginalPaper.pdf", "source_location": "Section 1", "weight": 1.0}, {"source": "loraoriginal_paper", "targ