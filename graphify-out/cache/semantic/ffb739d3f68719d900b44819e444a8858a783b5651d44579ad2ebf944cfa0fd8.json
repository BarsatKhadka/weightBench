{"nodes": [{"id": "paper:isotropic_model_merging", "label": "Isotropic Model Merging via Spectral Skewness", "file_type": "pdf", "source_file": "finding_literature/isotropic_model_merging_spectral_skewness.pdf", "description": "Analyzes spectral skewness in Task Arithmetic merged models; proposes Iso-C and Iso-CTS algorithms to flatten singular value spectrum for improved multi-task merging", "properties": {"arxiv_id": "2502.04959v3", "venue": "ICML 2025", "authors": ["Marczak", "Magistri", "Cygert", "Twardowski", "Bagdanov", "van de Weijer"]}}, {"id": "concept:spectral_skewness", "label": "Spectral Skewness", "file_type": "concept", "source_file": "finding_literature/isotropic_model_merging_spectral_skewness.pdf", "description": "Non-uniform distribution of singular values in the merged task matrix from Task Arithmetic; few dominant singular values with long tail of small values. Controls effective rank k_M and subspace alignment ratio.", "properties": {"formula": "skewed: sigma_1 >> sigma_2 >> ... >> sigma_r in Delta_M = sum_t Delta_t"}}, {"id": "concept:isotropic_merging", "label": "Isotropic Merging (Iso-C / Iso-CTS)", "file_type": "concept", "source_file": "finding_literature/isotropic_model_merging_spectral_skewness.pdf", "description": "Model merging approach that flattens the singular value spectrum of the merged task matrix to uniform (isotropic) values. Iso-C rescales to average singular value; Iso-CTS adds task-specific orthogonal directions.", "properties": {"iso_c_formula": "Delta_{Iso-C} = sigma_bar * U * V^T where sigma_bar = (1/r)*sum(sigma_i)", "algorithms": ["Iso-C", "Iso-CTS"]}}, {"id": "concept:iso_c_algorithm", "label": "Iso-C Algorithm", "file_type": "concept", "source_file": "finding_literature/isotropic_model_merging_spectral_skewness.pdf", "description": "Algorithm 1: sum task matrices, SVD, compute average singular value sigma_bar, reconstruct with isotropic spectrum. Basic isotropic merging variant.", "properties": {"steps": ["sum Delta_t", "SVD decomposition", "compute sigma_bar = (1/r)*sum(sigma_i)", "reconstruct Delta = sigma_bar*UV^T"]}}, {"id": "concept:iso_cts_algorithm", "label": "Iso-CTS Algorithm", "file_type": "concept", "source_file": "finding_literature/isotropic_model_merging_spectral_skewness.pdf", "description": "Algorithm 2: retain top-k common singular vectors, project out common subspace, compute task-specific SVDs, combine with orthogonalization via whitening, reconstruct with isotropic scaling. Achieves SOTA multi-task merging.", "properties": {"components": ["common subspace", "task-specific subspaces", "whitening orthogonalization", "isotropic scaling"]}}, {"id": "concept:subspace_alignment_ratio", "label": "Subspace Alignment Ratio (SAR)", "file_type": "concept", "source_file": "finding_literature/isotropic_model_merging_spectral_skewness.pdf", "description": "Metric quantifying overlap between subspaces of task matrix Delta_t and merged matrix Delta_M. SAR = ||Pi_{k_M,M} Delta_t||_F / ||Delta_t||_F. Strongly correlates (rho=0.94) with normalized accuracy improvement.", "properties": {"formula": "SAR(Delta_t, Delta_M; k_M) = ||Pi_{k_M,M} Delta_t||_F / ||Delta_t||_F", "correlation_with_NAI": 0.94}}, {"id": "concept:task_matrix", "label": "Task Matrix (Delta_t)", "file_type": "concept", "source_file": "finding_literature/isotropic_model_merging_spectral_skewness.pdf", "description": "Layer-wise weight update Delta_t = theta_t - theta_0 computed as difference between fine-tuned and pre-trained weights. Core object of model merging analysis; analyzed via SVD.", "properties": {"formula": "Delta_t = theta_t - theta_0"}}, {"id": "concept:effective_rank", "label": "Effective Rank (k_M)", "file_type": "concept", "source_file": "finding_literature/isotropic_model_merging_spectral_skewness.pdf", "description": "Number of significant singular values in the merged task matrix; directly controlled by spectral skewness. Lower k_M means fewer directions capture variance, reducing subspace alignment with individual task matrices.", "properties": {"controlled_by": "spectral_skewness"}}, {"id": "concept:task_arithmetic", "label": "Task Arithmetic (TA)", "file_type": "concept", "source_file": "finding_literature/isotropic_model_merging_spectral_skewness.pdf", "description": "Baseline model merging method: theta_TA = theta_0 + alpha * sum_t Delta_t. Produces skewed singular spectrum in the merged task matrix due to constructive/destructive interference.", "properties": {"formula": "theta_TA = theta_0 + alpha * sum_t Delta_t"}}, {"id": "concept:ties_merging", "label": "TIES-Merging", "file_type": "concept", "source_file": "finding_literature/isotropic_model_merging_spectral_skewness.pdf", "description": "Model merging method that resolves sign conflicts and prunes low-magnitude parameters before merging. Alternative to Task Arithmetic.", "properties": {"operations": ["sign conflict resolution", "low-magnitude pruning"]}}, {"id": "concept:knots_method", "label": "KnOTS", "file_type": "concept", "source_file": "finding_literature/isotropic_model_merging_spectral_skewness.pdf", "description": "SVD-based LoRA merging method that concatenates low-rank matrices before merging. Used as evaluation protocol for LoRA-adapted model merging experiments.", "properties": {"approach": "SVD-based concatenation of low-rank matrices"}}, {"id": "concept:singular_value_decomposition", "label": "Singular Value Decomposition (SVD)", "file_type": "concept", "source_file": "finding_literature/isotropic_model_merging_spectral_skewness.pdf", "description": "Matrix factorization M = U*Sigma*V^T used throughout model merging, LoRA analysis, and weight space learning. Provides basis for spectral analysis of weight matrices.", "properties": {"formula": "M = U*Sigma*V^T"}}, {"id": "concept:common_subspace", "label": "Common Subspace", "file_type": "concept", "source_file": "finding_literature/isotropic_model_merging_spectral_skewness.pdf", "description": "Shared singular directions across multiple task matrices; captured by top-k singular vectors of the merged task matrix Delta_M. Used in Iso-CTS to separate shared from task-specific representations.", "properties": {"role_in_iso_cts": "top-k common singular vectors retained and projected out"}}, {"id": "concept:task_specific_subspace", "label": "Task-Specific Subspace", "file_type": "concept", "source_file": "finding_literature/isotropic_model_merging_spectral_skewness.pdf", "description": "Per-task orthogonal directions added in Iso-CTS after projecting out common subspace. Preserves task-specific information not captured by the common subspace.", "properties": {"role_in_iso_cts": "residual task directions after projecting out common subspace"}}, {"id": "concept:singular_value_spectrum", "label": "Singular Value Spectrum", "file_type": "concept", "source_file": "finding_literature/isotropic_model_merging_spectral_skewness.pdf", "description": "Distribution of singular values of a weight matrix or task matrix. Non-uniform (skewed) spectrum leads to effective rank reduction in merged models. Core diagnostic tool for model merging quality.", "properties": {"analyzed_in": ["isotropic merging", "SeLoRA", "LoRA NTK analysis"]}}, {"id": "arch:vit_models", "label": "ViT Models (B/32, B/16, L/14)", "file_type": "architecture", "source_file": "finding_literature/isotropic_model_merging_spectral_skewness.pdf", "description": "Vision Transformer architectures used as base models for isotropic merging experiments. Evaluated on 8/14/20-task vision benchmarks.", "properties": {"variants": ["ViT-B/32", "ViT-B/16", "ViT-L/14"]}}], "edges": [{"source": "paper:isotropic_model_merging", "target": "concept:spectral_skewness", "relation": "introduces", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "finding_literature/isotropic_model_merging_spectral_skewness.pdf", "weight": 1.0}, {"source": "paper:isotropic_model_merging", "target": "concept:isotropic_merging", "relation": "proposes", "confidence": "