{"nodes": [{"id": "paper_frechet_model_merging_quotient_manifold", "label": "GeoMerge: Model Merging as Fr\u00e9chet Mean on Riemannian/Quotient Manifold", "file_type": "paper", "source_file": "C:\\Users\\barsa\\Documents\\weightBench\\finding_literature\\frechet_model_merging_quotient_manifold.pdf", "source_location": "pp.1-4", "source_url": "https://arxiv.org/abs/2604.27155", "captured_at": "2026-05-07", "author": "Marvin F. da Silva, Mohammed Adnan, Felix Dangel, Sageev Oore", "contributor": null}, {"id": "concept_frechet_mean_riemannian", "label": "Fr\u00e9chet Mean on Riemannian Manifold", "file_type": "rationale", "source_file": "C:\\Users\\barsa\\Documents\\weightBench\\finding_literature\\frechet_model_merging_quotient_manifold.pdf", "source_location": "pp.2-3", "source_url": "https://arxiv.org/abs/2604.27155", "captured_at": "2026-05-07", "author": "Marvin F. da Silva, Mohammed Adnan, Felix Dangel, Sageev Oore", "contributor": null, "rationale": "Central concept: the paper reframes model merging as finding the Fr\u00e9chet mean (generalised barycenter) on a Riemannian manifold equipped with a geodesic distance, enabling principled geometry-aware averaging of model weights."}, {"id": "concept_quotient_manifold_gl_r_symmetry", "label": "Quotient Manifold / GL(r) Symmetry in LoRA Factorizations", "file_type": "rationale", "source_file": "C:\\Users\\barsa\\Documents\\weightBench\\finding_literature\\frechet_model_merging_quotient_manifold.pdf", "source_location": "pp.3-4", "source_url": "https://arxiv.org/abs/2604.27155", "captured_at": "2026-05-07", "author": "Marvin F. da Silva, Mohammed Adnan, Felix Dangel, Sageev Oore", "contributor": null, "rationale": "LoRA weight increments \u0394W = GH have an inherent GL(r) symmetry: (G, H) ~ (GA^{-1}, HA^T) for invertible A. This makes the LoRA parameter space a quotient manifold, and orbit alignment (gauge fixing) is needed before averaging."}, {"id": "concept_orbit_alignment_gauge_fixing", "label": "Orbit Alignment / Gauge Fixing for LoRA Merging", "file_type": "rationale", "source_file": "C:\\Users\\barsa\\Documents\\weightBench\\finding_literature\\frechet_model_merging_quotient_manifold.pdf", "source_location": "pp.4", "source_url": "https://arxiv.org/abs/2604.27155", "captured_at": "2026-05-07", "author": "Marvin F. da Silva, Mohammed Adnan, Felix Dangel, Sageev Oore", "contributor": null, "rationale": "Before merging LoRA adapters, parameters from different orbits must be aligned to a canonical representative (gauge). Without this, averaging is ambiguous. GeoMerge uses polar decomposition (\u0394W = UBV^T) to fix to O(r) gauge."}, {"id": "concept_polar_factorization_o_r_symmetry", "label": "Polar Factorization / O(r) Symmetry (\u0394W = UBV^T)", "file_type": "rationale", "source_file": "C:\\Users\\barsa\\Documents\\weightBench\\finding_literature\\frechet_model_merging_quotient_manifold.pdf", "source_location": "pp.4", "source_url": "https://arxiv.org/abs/2604.27155", "captured_at": "2026-05-07", "author": "Marvin F. da Silva, Mohammed Adnan, Felix Dangel, Sageev Oore", "contributor": null, "rationale": "Factorizing \u0394W = UBV^T (polar form) reduces the GL(r) symmetry to O(r) symmetry. U and V lie on the Stiefel manifold; B is SPD. This enables separate Riemannian averaging on each factor."}, {"id": "concept_stiefel_manifold_spd_manifold", "label": "Stiefel Manifold and SPD Manifold (Affine-Invariant Metric)", "file_type": "rationale", "source_file": "C:\\Users\\barsa\\Documents\\weightBench\\finding_literature\\frechet_model_merging_quotient_manifold.pdf", "source_location": "pp.3-4", "source_url": "https://arxiv.org/abs/2604.27155", "captured_at": "2026-05-07", "author": "Marvin F. da Silva, Mohammed Adnan, Felix Dangel, Sageev Oore", "contributor": null, "rationale": "GeoMerge averages U and V on the Stiefel manifold using canonical metric, and B on the SPD manifold using the affine-invariant metric. These are Riemannian manifolds with well-defined geodesics and Fr\u00e9chet means."}, {"id": "concept_fisher_rao_geodesic_distance", "label": "Fisher-Rao Geodesic Distance and Fisher Information Matrix", "file_type": "rationale", "source_file": "C:\\Users\\barsa\\Documents\\weightBench\\finding_literature\\frechet_model_merging_quotient_manifold.pdf", "source_location": "pp.2-3", "source_url": "https://arxiv.org/abs/2604.27155", "captured_at": "2026-05-07", "author": "Marvin F. da Silva, Mohammed Adnan, Felix Dangel, Sageev Oore", "contributor": null, "rationale": "The Fisher-Rao metric induces a Riemannian geometry on the parameter space via the Fisher Information Matrix. The Fr\u00e9chet mean under this metric is intractable in general, but Fisher merging provides a tractable quadratic surrogate (Mahalanobis approximation)."}, {"id": "concept_fisher_merging_mahalanobis_surrogate", "label": "Fisher Merging as Tractable Mahalanobis/Fr\u00e9chet Surrogate", "file_type": "rationale", "source_file": "C:\\Users\\barsa\\Documents\\weightBench\\finding_literature\\frechet_model_merging_quotient_manifold.pdf", "source_location": "pp.2-3", "source_url": "https://arxiv.org/abs/2604.27155", "captured_at": "2026-05-07", "author": "Marvin F. da Silva, Mohammed Adnan, Felix Dangel, Sageev Oore", "contributor": null, "rationale": "Fisher merging (inverse-Fisher-weighted parameter average) is shown to be the solution to a quadratic approximation of the Fr\u00e9chet mean under Fisher-Rao metric, making it geometrically interpretable as an approximate Fr\u00e9chet mean."}, {"id": "concept_geoMerge_algorithm", "label": "GeoMerge Algorithm (Riemannian/Quotient Merging of LoRA Adapters)", "file_type": "rationale", "source_file": "C:\\Users\\barsa\\Documents\\weightBench\\finding_literature\\frechet_model_merging_quotient_manifold.pdf", "source_location": "pp.1,4-6", "source_url": "https://arxiv.org/abs/2604.27155", "captured_at": "2026-05-07", "author": "Marvin F. da Silva, Mohammed Adnan, Felix Dangel, Sageev Oore", "contributor": null, "rationale": "GeoMerge: (1) align LoRA orbits via polar decomposition, (2) separate into Stiefel (U,V) and SPD (B) factors, (3) compute Riemannian Fr\u00e9chet means on each manifold, (4) reconstruct merged adapter. Outperforms KnOTS on Llama-3 8B NLI tasks at 1/6 rank."}], "edges": [{"source": "paper_frechet_model_merging_quotient_manifold", "target": "concept_frechet_mean_riemannian", "relation": "introduces", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "C:\\Users\\barsa\\Documents\\weightBench\\finding_literature\\frechet_model_merging_quotient_manifold.pdf", "source_location": "pp.2-3", "weight": 1.0}, {"source": "paper_frechet_model_merging_quotient_manifold", "target": "concept_quotient_manifold_gl_r_symmetry", "relation": "introduces", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "C:\\Users\\barsa\\Documents\\weightBench\\finding_literature\\frechet_model_merging_quotient_manifold.pdf", "source_location": "pp.3-4", "weight": 1.0}, {"source": "paper_frechet_model_merging_quotient_manifold", "target": "concept_geoMerge_algorithm", "relation": "introduces", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "C:\\Users\\barsa\\Documents\\weightBench\\finding_literature\\frechet_model_merging_quotient_manifold.pdf", "source_location": "pp.1,4-6", "weight": 1.0}, {"source": "paper_frechet_model_merging_quotient_manifold", "target": "concept_fisher_rao_geodesic_distance", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "C:\\Users\\barsa\\Documents\\weightBench\\finding_literature\\frechet_model_merging_quotient_manifold.pdf", "source_location": "pp.2-3", "weight": 1.0}, {"source": "concept_quotient_manifold_gl_r_symmetry", "target": "concept_orbit_alignment_gauge_fixing", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "C:\\Users\\barsa\\Documents\\weightBench\\finding_literature\\frechet_model_merging_quotient_manifold.pdf", "source_location": "pp.4", "weight": 1.0}, {"source": "concept_orbit_alignment_gauge_fixing", "target": "concept_polar_factorization_o_r_symmetry", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "C:\\Users\\barsa\\Documents\\weightBench\\finding_literature\\frechet_model_merging_quotient_manifold.pdf", "source_location": "pp.4", "weight": 1.0}, {"source": "concept_polar_factorization_o_r_symmetry", "target": "concept_stiefel_manifold_spd_manifold", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "C:\\Users\\barsa\\Documents\\weightBench\\finding_literature\\frechet_model_merging_quotient_manifold.pdf", "source_location": "pp.3-4", "weight": 1.0}, {"source": "concept_stiefel_manifold_spd_manifold", "target": "concept_frechet_mean_riemannian", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "C:\\Users\\barsa\\Documents\\weightBench\\finding_literature\\frechet_model_merging_quotient_manifold.pdf", "source_location": "pp.3-4", "weight": 1.0}, {"source": "concept_frechet_mean_riemannian", "target": "concept_geoMerge_algorithm", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "C:\\Users\\barsa\\Documents\\weightBench\\finding_literature\\frechet_model_merging_quotient_manifold.pdf", "source_location": "pp.1,4-6", "weight": 1.0}, {"source": "concept_fisher_rao_geodesic_distance", "target": "concept_fisher_merging_mahalanobis_surrogate", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "C:\\Users\\barsa\\Documents\\weightBench\\finding_literature\\frechet_model_merging_quotient_manifold.pdf", "source_location": "pp.2-3", "weight": 1.0}, {"source": "concept_fisher_merging_mahalanobis_surrogate", "target": "concept_geoMerge_algorithm", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_scor