{"nodes": [{"id": "cross_lora_paper", "label": "Cross-LoRA Transfer for Heterogeneous LLMs", "file_type": "paper", "source_file": "finding_literature/cross_lora_transfer_heterogeneous_llms.pdf", "source_location": "Full paper", "source_url": "https://arxiv.org/abs/2508.05232", "captured_at": "2026-05-07", "author": "Xia et al. (Baidu/Imperial College London/Peking/Zhejiang/CMU)", "contributor": "claude-sonnet-4-6"}, {"id": "cross_lora_framework", "label": "Cross-LoRA Framework", "file_type": "paper", "source_file": "finding_literature/cross_lora_transfer_heterogeneous_llms.pdf", "source_location": "Section 3: Method Overview", "source_url": "https://arxiv.org/abs/2508.05232", "captured_at": "2026-05-07", "author": "Xia et al.", "contributor": "claude-sonnet-4-6", "rationale": "Data-free, training-free framework for transferring LoRA adapters across heterogeneous LLM architectures. Two-stage: LoRA-Align (subspace alignment) + LoRA-Shift (weight projection). Enables reuse of LoRAs across model families."}, {"id": "cross_lora_align", "label": "LoRA-Align Component", "file_type": "paper", "source_file": "finding_literature/cross_lora_transfer_heterogeneous_llms.pdf", "source_location": "Section 3.2: LoRA-Align", "source_url": "https://arxiv.org/abs/2508.05232", "captured_at": "2026-05-07", "author": "Xia et al.", "contributor": "claude-sonnet-4-6", "rationale": "Rank-truncated SVD + Frobenius-optimal linear transform. P_hat_U = argmin_P ||PU_s - U_t||_F^2; U_tilde_s = P_hat_U * U_s. Aligns source LoRA singular subspace to target model's weight subspace."}, {"id": "cross_lora_shift", "label": "LoRA-Shift Component", "file_type": "paper", "source_file": "finding_literature/cross_lora_transfer_heterogeneous_llms.pdf", "source_location": "Section 3.3: LoRA-Shift", "source_url": "https://arxiv.org/abs/2508.05232", "captured_at": "2026-05-07", "author": "Xia et al.", "contributor": "claude-sonnet-4-6", "rationale": "Frobenius projection into target subspace. Delta_W_t = U_tilde_s (U_tilde_s^T Delta_W_s V_tilde_s) V_tilde_s^T. Projects aligned source LoRA weights onto target model's principal subspace."}, {"id": "cross_lora_rank_truncation", "label": "Rank-320 Truncation Strategy", "file_type": "paper", "source_file": "finding_literature/cross_lora_transfer_heterogeneous_llms.pdf", "source_location": "Section 3.1: Preprocessing", "source_url": "https://arxiv.org/abs/2508.05232", "captured_at": "2026-05-07", "author": "Xia et al.", "contributor": "claude-sonnet-4-6", "rationale": "Rank-320 truncation retains >= 99% Frobenius energy. Reduces SVD complexity from O(mn*min(m,n)) to O(rmn). Approximately 20 minutes on 8GB GPU for full model transfer."}, {"id": "cross_lora_architecture_sensitivity", "label": "Architecture Sensitivity in Cross-LoRA", "file_type": "paper", "source_file": "finding_literature/cross_lora_transfer_heterogeneous_llms.pdf", "source_location": "Section 5: Analysis", "source_url": "https://arxiv.org/abs/2508.05232", "captured_at": "2026-05-07", "author": "Xia et al.", "contributor": "claude-sonnet-4-6", "rationale": "GQA+SwiGLU+RMSNorm models (LLaMA, Qwen) transfer well to each other. MHA+GeLU architecture (Gemma-2-2B) shows inconsistent transfer. Architecture similarity predicts transfer success."}, {"id": "cross_lora_experiments", "label": "Cross-LoRA Transfer Experiments", "file_type": "paper", "source_file": "finding_literature/cross_lora_transfer_heterogeneous_llms.pdf", "source_location": "Section 4: Experiments", "source_url": "https://arxiv.org/abs/2508.05232", "captured_at": "2026-05-07", "author": "Xia et al.", "contributor": "claude-sonnet-4-6", "rationale": "Models: LLaMA-3.2-3B, Qwen2.5-1.5B, Qwen2.5-3B, Gemma-2-2B. Results: up to +5.26% on ARC-c, +3.32% on ARC-e over zero-shot baseline. Data-free and training-free."}, {"id": "cross_lora_paper", "label": "Cross-LoRA: A Data-Free LoRA Transfer Framework across Heterogeneous LLMs", "file_type": "paper", "source_file": "finding_literature/cross_lora_transfer_he