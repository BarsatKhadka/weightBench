{"nodes": [{"id": "dwsnets_paper", "label": "Equivariant Deep Weight Space Alignment (Deep-Align / DWSNets)", "file_type": "paper", "source_file": "relevant_literature_but_not_limited_to/DWSNets.pdf", "source_location": null, "source_url": "https://arxiv.org/abs/2310.13397", "captured_at": null, "author": "Aviv Navon, Aviv Shamsian, Ethan Fetaya, Gal Chechik, Nadav Dym, Haggai Maron", "contributor": null}, {"id": "dwsnets_deep_align", "label": "Deep-Align Framework", "file_type": "rationale", "source_file": "relevant_literature_but_not_limited_to/DWSNets.pdf", "source_location": "Section 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A learning-based weight alignment method using DWSNets with Siamese architecture. Alignment is reduced to a feedforward pass rather than iterative optimization (NP-hard in general). Equivariance design reduces training set size requirements and enables efficient inference."}, {"id": "dwsnets_permutation_symmetry", "label": "Permutation Symmetry of Neural Networks", "file_type": "rationale", "source_file": "relevant_literature_but_not_limited_to/DWSNets.pdf", "source_location": "Abstract, Section 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deep networks maintain function under permutations of weights, making naive weight averaging or distance computation meaningless without alignment. This symmetry motivates equivariant architectures that respect it by design."}, {"id": "dwsnets_weight_alignment", "label": "Weight Alignment", "file_type": "rationale", "source_file": "relevant_literature_but_not_limited_to/DWSNets.pdf", "source_location": "Section 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Finding optimal permutations between two networks' weight matrices to make them comparable. Critical for model merging, loss landscape study, and federated learning. NP-hard in general; prior work uses relaxed optimization."}], "edges": [{"source": "dwsnets_paper", "target": "dwsnets_deep_align", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "relevant_literature_but_not_limited_to/DWSNets.pdf", "source_location": "Section 1", "weight": 1.0}, {"source": "dwsnets_paper", "target": "dwsnets_permutation_symmetry", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "relevant_literature_but_not_limited_to/DWSNets.pdf", "source_location": "Abstract", "weight": 1.0}, {"source": "dwsnets_paper", "target": "dwsnets_weight_alignment", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "relevant_literature_but_not_limited_to/DWSNets.pdf", "source_location": "Section 1", "weight": 1.0}, {"source": "dwsnets_permutation_symmetry", "target": "dwsnets_weight_alignment", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "relevant_literature_but_not_limited_to/DWSNets.pdf", "source_location": "Section 1", "weight": 1.0}, {"source": "dwsnets_deep_align", "target": "dwsnets_weight_alignment", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "relevant_literature_but_not_limited_to/DWSNets.pdf", "source_location": "Section 1", "weight": 1.0}, {"source": "dwsnets_paper", "target": "editingmodelwithtaskarithmetic_paper", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "relevant_literature_but_not_limited_to/DWSNets.pdf", "source_location": "Section 1", "weight": 1.0}], "hyperedges": []}