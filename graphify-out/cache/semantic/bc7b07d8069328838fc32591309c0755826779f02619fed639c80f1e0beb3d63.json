{"nodes": [{"id": "paper:learning_on_loras_gl_equivariant", "label": "Learning on LoRAs: GL-Equivariant Processing of Low-Rank Weight Spaces", "file_type": "pdf", "source_file": "finding_literature/learning_on_loras_gl_equivariant_weight_space.pdf", "description": "Formalizes GL(r)-equivariance symmetry in LoRA weight spaces; proposes GL-net architecture for equivariant processing of LoRA populations", "properties": {"arxiv_id": "2410.04207v2", "authors": ["Putterman", "Lim", "Gelberg", "Jegelka", "Maron"]}}, {"id": "concept:gl_equivariance", "label": "GL(r)-Equivariance/Invariance", "file_type": "concept", "source_file": "finding_literature/learning_on_loras_gl_equivariant_weight_space.pdf", "description": "LoRA weights (U,V) have symmetry under general linear group GL(r): U*R*R^{-1}*V^T = U*V^T for any invertible R. Any function learning on LoRAs must be invariant or equivariant to this symmetry.", "properties": {"symmetry_group": "GL(r)", "formula": "f(U, V) = f(U*R, R^{-T}*V^T) for all R in GL(r)"}}, {"id": "concept:lol_framework", "label": "Learning on LoRAs (LoL) Framework", "file_type": "concept", "source_file": "finding_literature/learning_on_loras_gl_equivariant_weight_space.pdf", "description": "Paradigm where LoRA weight matrices serve as input to ML models for predicting properties of fine-tuned models (e.g., downstream accuracy, aesthetic quality). Must handle GL(r) symmetry.", "properties": {"input": "LoRA weight matrices (U, V)", "output": "model property predictions"}}, {"id": "concept:gl_net", "label": "GL-net Architecture", "file_type": "concept", "source_file": "finding_literature/learning_on_loras_gl_equivariant_weight_space.pdf", "description": "Equivariant architecture for processing LoRA weights using GL-equivariant linear layers + GL-equivariant nonlinearities + invariant readout head. Provably GL-invariant.", "properties": {"components": ["GL-equivariant linear layer", "GL-equivariant nonlinearity", "invariant head"], "nonlinearity_formula": "sigma_GL(U)_i = sigma(sum_j(UV^T)_{ij}) * U_i"}}, {"id": "concept:gl_equivariant_linear_layer", "label": "GL-Equivariant Linear Layer", "file_type": "concept", "source_file": "finding_literature/learning_on_loras_gl_equivariant_weight_space.pdf", "description": "F_Linear(U_1,V_1,...,U_L,V_L) = (Phi_1*U_1, Psi_1*V_1,...). All linear GL-equivariant layers must have this form (Proposition 1). Acts separately on U and V matrices.", "properties": {"formula": "F_Linear(U,V) = (Phi*U, Psi*V)", "proposition": "Proposition 1: all linear GL-equivariant layers have this form"}}, {"id": "concept:lora_symmetry", "label": "LoRA Symmetry Groups", "file_type": "concept", "source_file": "finding_literature/learning_on_loras_gl_equivariant_weight_space.pdf", "description": "LoRA has inner permutation symmetries (UP^T PV^T = UV^T) but NOT outer permutation symmetries. GL(r) is the full symmetry group; O(r) (orthogonal group) is a strict subgroup.", "properties": {"full_symmetry": "GL(r)", "subgroup": "O(r)", "inner_permutation": true, "outer_permutation": false}}, {"id": "concept:lora_population_manifold", "label": "LoRA Population Manifold", "file_type": "concept", "source_file": "finding_literature/learning_on_loras_gl_equivariant_weight_space.pdf", "description": "The space of all LoRA fine-tuned models viewed as a manifold parameterized by (U, V) weight matrices. Quotiented by GL(r) symmetry; points on this manifold correspond to distinct fine-tuned behaviors.", "properties": {"datasets": ["CelebA-LoRA (3900 rank-4 SD 1.4 finetunes)", "Imagenette-LoRA (2046 rank-32 SD finetunes)", "Qwen2-ARC-LoRA (2000 Qwen2-1.5B LoRAs)"]}}, {"id": "concept:weight_space_learning", "label": "Weight Space Learning", "file_type": "concept", "source_file": "finding_literature/learning_on_loras_gl_equivariant_weight_space.pdf", "description": "Learning directly from neural network weights as inputs; encompasses meta-learning, model editing, model merging prediction, and generation of weights. LoL is 