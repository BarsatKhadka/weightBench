{"nodes": [{"id": "paper:lora_ntk_regime", "label": "LoRA Training in NTK Regime: No Spurious Local Minima", "file_type": "pdf", "source_file": "finding_literature/lora_ntk_regime_no_spurious_minima.pdf", "description": "Proves LoRA training with prompt-based fine-tuning operates in NTK regime; establishes rank threshold above which all second-order stationary points are global minima", "properties": {"arxiv_id": "2402.11867v3", "venue": "ICML 2024", "authors": ["Jang", "Lee", "Ryu"]}}, {"id": "concept:ntk_regime", "label": "Neural Tangent Kernel (NTK) Regime", "file_type": "concept", "source_file": "finding_literature/lora_ntk_regime_no_spurious_minima.pdf", "description": "Linearized training dynamics where network change is approximated by first-order Taylor expansion. LoRA training with prompt-based fine-tuning empirically operates in NTK regime; enables theoretical guarantees.", "properties": {"linearization": "f_{W_0+delta}(X) approx f_{W_0}(X) + <grad f_{W_0}(X), delta>", "empirical_validation": "prompt-based fine-tuning stays in NTK regime"}}, {"id": "concept:spurious_local_minima", "label": "Spurious Local Minima", "file_type": "concept", "source_file": "finding_literature/lora_ntk_regime_no_spurious_minima.pdf", "description": "Local minima that are not global minima in the optimization landscape. Eliminated in LoRA NTK setting when rank r satisfies r(r+1)/2 > KN (Theorem 4.1). All SOSPs become global minima above this threshold.", "properties": {"eliminated_when": "r(r+1)/2 > KN", "theorem": "Theorem 4.1"}}, {"id": "concept:rank_threshold", "label": "Rank Threshold for No Spurious Minima", "file_type": "concept", "source_file": "finding_literature/lora_ntk_regime_no_spurious_minima.pdf", "description": "Sufficient rank condition r >= sqrt(N) for no spurious local minima in LoRA NTK regime. Derived from r(r+1)/2 > KN where K is number of classes and N is number of training samples.", "properties": {"condition": "r(r+1)/2 > KN", "simplified": "r >= sqrt(N)", "K": "number of output classes", "N": "number of training samples"}}, {"id": "concept:second_order_stationary_points", "label": "Second-Order Stationary Points (SOSPs)", "file_type": "concept", "source_file": "finding_literature/lora_ntk_regime_no_spurious_minima.pdf", "description": "Points where gradient is zero and Hessian is positive semi-definite. Shown to be global minima in LoRA NTK regime above rank threshold (Theorem 4.1). Key concept in non-convex optimization theory.", "properties": {"definition": "grad L=0 and Hess L PSD", "theorem_result": "All SOSPs are global minimizers above rank threshold"}}, {"id": "concept:nuclear_norm_regularization", "label": "Nuclear Norm Regularization", "file_type": "concept", "source_file": "finding_literature/lora_ntk_regime_no_spurious_minima.pdf", "description": "Equivalent to weight decay on LoRA factor matrices via Burer-Monteiro connection. Minimizing L + (lambda/2)||u||^2 + (lambda/2)||v||^2 is equivalent to minimizing L_lambda + lambda*||delta||_* (nuclear norm).", "properties": {"lemma": "Lemma 2.2", "formula": "L(u,v) + lambda*||u||^2 + lambda*||v||^2 equiv L(delta) + lambda*||delta||_*"}}, {"id": "concept:rademacher_complexity", "label": "Rademacher Complexity", "file_type": "concept", "source_file": "finding_literature/lora_ntk_regime_no_spurious_minima.pdf", "description": "Statistical measure used to derive generalization bounds for low-rank LoRA solutions. Theorem 5.1 bounds generalization error in terms of nuclear norm of optimal solution and Rademacher complexity.", "properties": {"theorem": "Theorem 5.1", "bound": "L(u_hat*v_hat^T) - L(delta*) < ||delta*||_* * (2(2+eps)^2*sqrt(K*GR/N)*(2+sqrt(log(1/eta))))"}}, {"id": "concept:burer_monteiro", "label": "Burer-Monteiro Factorization", "file_type": "concept", "source_file": "finding_literature/lora_ntk_regime_no_spurious_minima.pdf", "description": "Matrix factorization approach delta = u*v^T connecting LoRA parameterization to nuclear norm regularization. Low-rank factorization that enables theoretical analysis of LoRA optimization landscape.", "properties": {"connection": "weight decay on factors <=> nuclear norm on product"}}, {"id": "concept:lora_adaptation", "label": "LoRA Adaptation", "file_type": "concept", "source_file": "finding_literature/lora_ntk_regime_no_spurious_minima.pdf", "description": "Low-rank adaptation method: W' = W_0 + B*A where B in R^{m x r}, A in R^{r x n}, r << min(m,n). Parameter-efficient fine-tuning paradigm that introduces low-rank structure into weight updates.", "properties": {"formula": "W' = W_0 + B*A", "constraint": "rank(BA) <= r << min(m,n)"}}, {"id": "concept:optimal_rank", "label": "Optimal LoRA Rank", "file_type": "concept", "source_file": "finding_literature/lora_ntk_regime_no_spurious_minima.pdf", "description": "Minimum rank r sufficient for no spurious local minima: r >= sqrt(N). Also studied in parameter redundancy context: optimal rank for best performance-efficiency tradeoff.", "properties": {"no_spurious_minima_threshold": "r >= sqrt(N)", "selora_rank": "r=32 with sparse spectral encoding achieves efficiency"}}, {"id": "concept:low_rank_solution_existence", "label": "Low-Rank Solution Existence Theorem", "file_type": "concept", "source_file": "finding_literature/lora_ntk_regime_no_spurious_minima.pdf", "description": "Theorem 3.1: A low-rank LoRA solution exists with rank r satisfying r(r+1)/2 <= KN. Establishes fundamental existence result before proving optimization landscape properties.", "properties": {"theorem": "Theorem 3.1", "condition": "r(r+1)/2 <= KN"}}, {"id": "lora_ntk_paper", "label": "LoRA Training in the NTK Regime Has No Spurious Local Minima", "file_type": "paper", "source_file": "finding_literature/lora_ntk_regime_no_spurious_minima.pdf", "source_location": null, "source_url": "https://arxiv.org/abs/2402.11867", "captured_at": null, "author": "Uijeong Jang, Jason D. Lee, Ernest K. Ryu", "contributor": null}, {"id": "lora_ntk_ntk_regime", "label": "Neur