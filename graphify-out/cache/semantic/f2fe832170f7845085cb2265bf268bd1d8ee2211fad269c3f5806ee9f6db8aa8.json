{"nodes": [{"id": "paper:lora_interference_orthogonal_subspaces", "label": "Reducing LoRA Interference via Orthogonal Subspace Initialization", "file_type": "pdf", "source_file": "finding_literature/lora_interference_orthogonal_subspaces.pdf", "description": "Proposes OSRM: constraining LoRA A matrix to subspace orthogonal to out-of-task data distributions before fine-tuning to reduce cross-task interference in model merging", "properties": {"arxiv_id": "2505.22934v1", "authors": ["Zhang", "Zhou"], "institution": "University of Michigan"}}, {"id": "concept:osrm_method", "label": "OSRM: Orthogonal Subspaces for Robust Model Merging", "file_type": "concept", "source_file": "finding_literature/lora_interference_orthogonal_subspaces.pdf", "description": "Method to constrain LoRA A matrix initialization to subspace orthogonal to out-of-task data distributions before fine-tuning. Minimizes cross-task interference in merged models.", "properties": {"optimization": "min_A ||A*H_1^T||_F s.t. A*A^T = I", "solution": "A_tilde = V_{:,n-r:n}^T (last r eigenvectors of sample covariance)"}}, {"id": "concept:orthogonal_subspace_initialization", "label": "Orthogonal Subspace Initialization", "file_type": "concept", "source_file": "finding_literature/lora_interference_orthogonal_subspaces.pdf", "description": "Analytical solution for OSRM: initialize LoRA A as the last r eigenvectors (smallest eigenvalues) of the sample covariance matrix S = (1/(k-1))*H^T*H of latent features.", "properties": {"formula": "A_tilde = V_{:,n-r:n}^T where S = V*Lambda*V^T", "covariance": "S = (1/(k-1))*H^T*H"}}, {"id": "concept:data_parameter_interaction", "label": "Data-Parameter Interaction", "file_type": "concept", "source_file": "finding_literature/lora_interference_orthogonal_subspaces.pdf", "description": "Interplay between latent features H and LoRA parameter updates BA. Minimizing ||A_2*H_1^T||_F reduces cross-task interference by ensuring task 2's LoRA A does not activate task 1's feature directions.", "properties": {"interference_term": "||A_2*H_1^T||_F"}}, {"id": "concept:task_interference", "label": "Task Interference", "file_type": "concept", "source_file": "finding_literature/lora_interference_orthogonal_subspaces.pdf", "description": "When merging multiple LoRA fine-tuned models, one task's parameter updates degrade performance on other tasks. Caused by non-orthogonal subspace overlap between task-specific LoRA A matrices and other tasks' feature distributions.", "properties": {"mechanism": "LoRA A_t not orthogonal to H_{t'} for t != t'", "measured_by": "||A_t*H_{t'}^T||_F"}}, {"id": "concept:orthogonal_procrustes", "label": "Orthogonal Procrustes Problem", "file_type": "concept", "source_file": "finding_literature/lora_interference_orthogonal_subspaces.pdf", "description": "Used in OSRM to verify LoRA A matrix remains close to its orthogonal initialization after fine-tuning. D = min_Omega ||Omega*A^{ft} - A^{init}||_F. Change found to be \u226414% empirically.", "properties": {"formula": "D = min_Omega ||Omega*A^{ft} - A^{init}||_F", "empirical_change": "<=14%"}}, {"id": "concept:sample_covariance", "label": "Sample Covariance of Latent Features", "file_type": "concept", "source_file": "finding_literature/lora_interference_orthogonal_subspaces.pdf", "description": "S = (1/(k-1))*H^T*H computed from latent features H of out-of-task data. Eigenvectors define the subspace directions; OSRM initializes LoRA A to last r eigenvectors (smallest eigenvalue directions).", "properties": {"formula": "S = (1/(k-1))*H^T*H", "implementation": "100 samples per task for H_t"}}, {"id": "arch:roberta_model", "label": "RoBERTa Models", "file_type": "architecture", "source_file": "finding_literature/lora_interference_orthogonal_subspaces.pdf", "description": "RoBERTa-large used in OSRM experiments (rank=8, alpha=16, query+value only); RoBERTa-base used in NTK regime experiments (N=32 samples, SST-2/QNLI/CR/QQP/Subj tasks).", "properties": {"osrm_config": "rank=8, alpha=16, query+value", "ntk_config": "N=32 samples, NLP classification tasks"}}, {"id": "lora_interference_orthogonal_subspaces_paper", "label": "Unraveling LoRA Interference: Orthogonal Subspaces for Robust Model Merging", "file_type": "paper", "source_file": "finding_literature/lora_interference_orthogonal_subspaces.pdf", "source_location": null, "source_url": "https://arxiv.org/abs/2505.22934", "captured_at": null, "author": "Haobo Zhang, Jiayu Zhou", "contributor": null}, {"id": "lora_interference_osrm_method", "label": "OSRM: Orthogonal Subspaces for Robust Model Merging", "file_type": "rationale", "source_file": "finding_literature/lora_interference_orthogonal_subspaces.pdf", "source_location": "Section 4", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "lora_interference_parameter_data_interaction", "label": "Parameter-Data Interaction in LoRA Model Merging", "file_type": "rationale", "source_file": "finding_literature/lora_interference_orthogonal_subspaces.pdf", "source_location": "Section 1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "lora_interference_lora_subspace_constraint", "label": "LoRA Subspace Constraint Before Fine-Tuning", "file_type": "rationale", "source_file": "finding_literature/lora_interference_orthogonal_subspaces.pdf", "source_location": "Section 4.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "lora_interference_task_arithmetic", "label": "Task Arithmetic (TA) Model Merging Method", "file_type": "rationale", "source_file": "finding_literature/lora_interference_orthogonal_subspaces.pdf", "source_location": "Section 3", "source_url": null, "captured_at": null, "author": "Ilharco et al. 2022", "contributor": null}, {"id": "lora_interference_ties_merging", "label": "TIES Merging Method", "file_type": "rationale", "source_file": "finding_literature/lora_interference_orthogonal_subspaces.pdf", "source_location": "Section 3",