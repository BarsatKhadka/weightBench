{"nodes": [{"id": "selfsupervisedweightlearning_paper", "label": "Self-Supervised Representation Learning on Neural Network Weights for Model Characteristic Prediction", "file_type": "paper", "source_file": "relevant_literature_but_not_limited_to/SelfSupervisedRepresentationLearningOnNeuralNetworkWeights.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": "Konstantin Sch\u00fcrholt, Dimche Kostadinov, Damian Borth", "contributor": null}, {"id": "selfsupervisedweightlearning_hyper_representations", "label": "Hyper-Representations of Neural Network Weights", "file_type": "rationale", "source_file": "relevant_literature_but_not_limited_to/SelfSupervisedRepresentationLearningOnNeuralNetworkWeights.pdf", "source_location": "Section 1, 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SSL (reconstruction + contrastive) applied to populations of trained NNs (model zoos) to learn task-agnostic latent representations. Domain-specific augmentations (permutation, erasing, noise) are critical; permutation augmentation exploits weight-space symmetries and creates near-free valid NN samples for contrastive pairs."}, {"id": "selfsupervisedweightlearning_model_zoo", "label": "Model Zoo", "file_type": "rationale", "source_file": "relevant_literature_but_not_limited_to/SelfSupervisedRepresentationLearningOnNeuralNetworkWeights.pdf", "source_location": "Section 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A dataset of trained neural networks with diverse configurations (data, hyperparameters, architecture). Serves as the training corpus for learning hyper-representations. Seed variation within a model zoo adds beneficial diversity for recovering model properties."}, {"id": "selfsupervisedweightlearning_permutation_augmentation", "label": "Permutation Augmentation for Neural Network Weights", "file_type": "rationale", "source_file": "relevant_literature_but_not_limited_to/SelfSupervisedRepresentationLearningOnNeuralNetworkWeights.pdf", "source_location": "Section 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Permuting incoming/outgoing weights of a neuron preserves the network's mapping exactly. This creates valid augmented samples at near-zero cost (each layer with N neurons has N! permutations) and exploits structural symmetry as an inductive bias for contrastive learning."}], "edges": [{"source": "selfsupervisedweightlearning_paper", "target": "selfsupervisedweightlearning_hyper_representations", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "relevant_literature_but_not_limited_to/SelfSupervisedRepresentationLearningOnNeuralNetworkWeights.pdf", "source_location": "Section 1", "weight": 1.0}, {"source": "selfsupervisedweightlearning_paper", "target": "selfsupervisedweightlearning_model_zoo", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "relevant_literature_but_not_limited_to/SelfSupervisedRepresentationLearningOnNeuralNetworkWeights.pdf", "source_location": "Section 2", "weight": 1.0}, {"source": "selfsupervisedweightlearning_paper", "target": "selfsupervisedweightlearning_permutation_augmentation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "relevant_literature_but_not_limited_to/SelfSupervisedRepresentationLearningOnNeuralNetworkWeights.pdf", "source_location": "Section 2", "weight": 1.0}, {"source": "selfsupervisedweightlearning_permutation_augmentation", "target": "selfsupervisedweightlearning_hyper_representations", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "relevant_literature_but_not_limited_to/SelfSupervisedRepresentationLearningOnNeuralNetworkWeights.pdf", "source_location": "Section 2", "weight": 1.0}, {"source": "selfsupervisedweightlearning_model_zoo", "target": "