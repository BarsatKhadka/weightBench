{"nodes": [{"id": "paper_fisher_subspace_lora_initialization", "label": "FILet: Fisher-Guided LoRA Initialization via Minimal Fisher Energy Directions", "file_type": "paper", "source_file": "C:\\Users\\barsa\\Documents\\weightBench\\finding_literature\\fisher_subspace_lora_initialization.pdf", "source_location": "pp.1-4", "source_url": "https://arxiv.org/abs/2605.01046", "captured_at": "2026-05-07", "author": "Zhi-Quan Feng, Ying-Jia Lin, Hung-Yu Kao", "contributor": null}, {"id": "concept_fisher_energy_lora_direction", "label": "Fisher Energy E(Z) for LoRA Direction Selection", "file_type": "rationale", "source_file": "C:\\Users\\barsa\\Documents\\weightBench\\finding_literature\\fisher_subspace_lora_initialization.pdf", "source_location": "pp.2-3", "source_url": "https://arxiv.org/abs/2605.01046", "captured_at": "2026-05-07", "author": "Zhi-Quan Feng, Ying-Jia Lin, Hung-Yu Kao", "contributor": null, "rationale": "FILet defines Fisher Energy E(Z) = vec(Z)^T S_W vec(Z) for a LoRA direction Z, where S_W is the Fisher information of the pretrained weights W_0. Directions with minimal Fisher Energy cause least disruption to pretrained knowledge, making them ideal for LoRA initialization."}, {"id": "concept_kfac_kronecker_factored_fisher", "label": "K-FAC Kronecker-Factored Fisher Approximation (S_W \u2248 S_X \u2297 S_Y)", "file_type": "rationale", "source_file": "C:\\Users\\barsa\\Documents\\weightBench\\finding_literature\\fisher_subspace_lora_initialization.pdf", "source_location": "pp.3", "source_url": "https://arxiv.org/abs/2605.01046", "captured_at": "2026-05-07", "author": "Zhi-Quan Feng, Ying-Jia Lin, Hung-Yu Kao", "contributor": null, "rationale": "The full Fisher S_W is intractable to compute and invert. K-FAC approximates it as a Kronecker product S_W \u2248 S_X \u2297 S_Y, where S_X and S_Y are computed from input activations and gradient covariances. This factorization makes the Fisher Energy tractable."}, {"id": "concept_filet_algorithm", "label": "FILet Algorithm (Fisher-Guided LoRA Initialization via Minimum Fisher Energy)", "file_type": "rationale", "source_file": "C:\\Users\\barsa\\Documents\\weightBench\\finding_literature\\fisher_subspace_lora_initialization.pdf", "source_location": "pp.3-4", "source_url": "https://arxiv.org/abs/2605.01046", "captured_at": "2026-05-07", "author": "Zhi-Quan Feng, Ying-Jia Lin, Hung-Yu Kao", "contributor": null, "rationale": "FILet: (1) compute S_X and S_Y via K-FAC from minibatch, (2) project Fisher into surrogate basis V\u0302=normalize(G_X), \u00db=normalize(W_0 V\u0302), (3) select top-r directions by minimum Fisher Energy (TopK(-\u03a3_fisher, r)), (4) initialize LoRA A and B from selected directions. Outperforms PiSSA, MiLoRA, KaSA, LoRA-Dash."}, {"id": "concept_lora_subspace_initialization", "label": "LoRA Subspace Initialization (Structured vs Random Initialization)", "file_type": "rationale", "source_file": "C:\\Users\\barsa\\Documents\\weightBench\\finding_literature\\fisher_subspace_lora_initialization.pdf", "source_location": "pp.1-2", "source_url": "https://arxiv.org/abs/2605.01046", "captured_at": "2026-05-07", "author": "Zhi-Quan Feng, Ying-Jia Lin, Hung-Yu Kao", "contributor": null, "rationale": "The choice of which subspace LoRA adapts determines both training efficiency and interference with pretrained knowledge. FILet, PiSSA, MiLoRA, and KaSA are all subspace initialization strategies; FILet selects minimal-disturbance directions via Fisher Energy."}], "edges": [{"source": "paper_fisher_subspace_lora_initialization", "target": "concept_fisher_energy_lora_direction", "relation": "introduces", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "C:\\Users\\barsa\\Documents\\weightBench\\finding_literature\\fisher_subspace_lora_initialization.pdf", "source_location": "pp.2-3", "weight": 1.0}, {"source": "paper_fisher_subspace_lora_initialization", "target": "concept_filet_algorithm", "relation": "introduces", "confidence": "EXTRACTED", "confidence_