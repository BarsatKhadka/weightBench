{"nodes": [{"id": "knowledgeinweightspace_paper", "label": "Knowledge Is a Region in Weight Space for Finetuned Language Models", "file_type": "paper", "source_file": "relevant_literature_but_not_limited_to/KnowledgeIsARegionInWeightSpace.pdf", "source_location": null, "source_url": "https://arxiv.org/abs/2302.04863", "captured_at": null, "author": "Almog Gueta, Elad Venezian, Colin Raffel, Noam Slonim, Yoav Katz, Leshem Choshen", "contributor": null}, {"id": "knowledgeinweightspace_weight_region", "label": "Knowledge Region in Weight Space", "file_type": "rationale", "source_file": "relevant_literature_but_not_limited_to/KnowledgeIsARegionInWeightSpace.pdf", "source_location": "Abstract, Section 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fine-tuned models optimized for high performance cluster in well-defined, linearly connected regions of weight space. Any model within a region also performs well. The center of such a region outperforms individual fine-tuned models on average, suggesting the best models may not lie at region edges (where gradient-based fine-tuning typically ends)."}, {"id": "knowledgeinweightspace_linear_connectivity", "label": "Linear Mode Connectivity", "file_type": "rationale", "source_file": "relevant_literature_but_not_limited_to/KnowledgeIsARegionInWeightSpace.pdf", "source_location": "Section 5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Models fine-tuned on the same dataset are linearly connected in weight space \u2014 the convex hull between them forms a connected low-loss basin. This extends the linear connectivity result of Entezari et al. to a full bounded convex region, not just a line."}], "edges": [{"source": "knowledgeinweightspace_paper", "target": "knowledgeinweightspace_weight_region", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "relevant_literature_but_not_limited_to/KnowledgeIs